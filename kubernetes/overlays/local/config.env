# ============================================================
# PULSE local development config
# GCP managed services are replaced with in-cluster emulators.
# ============================================================

# Redis — in-cluster (resources/redis.yml)
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# GCP project ID — must match the --project flag passed to the Pub/Sub emulator
SPRING_CLOUD_GCP_PROJECT_ID=local-dev

# Pub/Sub emulator — Spring Cloud GCP auto-routes to this host instead of GCP
SPRING_CLOUD_GCP_PUBSUB_EMULATOR_HOST=pubsub-emulator:8085

# Pub/Sub topic and subscriptions — created by the pubsub-setup Job on first deploy
PULSE_PUBSUB_EVENTS_TOPIC=events
PULSE_PUBSUB_PROCESSOR_SUBSCRIPTION=processor-sub
PULSE_PUBSUB_PROJECTOR_SUBSCRIPTION=projector-sub

# OAuth2 — fill in a local provider (e.g. Keycloak) or configure the app to bypass auth locally
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=FILL_IN
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=FILL_IN

# PostgreSQL — in-cluster (resources/postgres.yml), used by projector via patches/projector.yml
SPRING_DATASOURCE_USERNAME=pulse
SPRING_DATASOURCE_PASSWORD=pulse
