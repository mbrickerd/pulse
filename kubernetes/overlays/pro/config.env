# ============================================================
# PULSE production config — populate from terraform outputs
# Run: terraform -chdir=infra/terraform output
# ============================================================

# terraform output: memorystore_host
SPRING_DATA_REDIS_HOST=FILL_IN

# Redis port is fixed for Memorystore
SPRING_DATA_REDIS_PORT=6379

# terraform output: project_id
SPRING_CLOUD_GCP_PROJECT_ID=FILL_IN

# Pub/Sub topic and subscriptions — provisioned by terraform pubsub module.
# terraform output: pubsub_events_topic
PULSE_PUBSUB_EVENTS_TOPIC=FILL_IN
# terraform output: pubsub_processor_subscription
PULSE_PUBSUB_PROCESSOR_SUBSCRIPTION=FILL_IN
# terraform output: pubsub_projector_subscription
PULSE_PUBSUB_PROJECTOR_SUBSCRIPTION=FILL_IN

# terraform output: identity_platform_issuer_uri
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=FILL_IN

# terraform output: identity_platform_jwk_set_uri
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=FILL_IN

# terraform output: cloudsql_connection_name
# Format: PROJECT_ID:REGION:INSTANCE_NAME (e.g., my-project:us-central1:pulse-pro-postgres)
CLOUDSQL_CONNECTION_NAME=FILL_IN

# terraform output: projector_gsa_email — strip .gserviceaccount.com from the end
# e.g. pulse-pro-projector@my-project.iam.gserviceaccount.com → pulse-pro-projector@my-project.iam
SPRING_DATASOURCE_USERNAME=FILL_IN
